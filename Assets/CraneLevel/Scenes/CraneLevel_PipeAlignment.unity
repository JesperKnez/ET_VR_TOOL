--- !u!114 &490387585
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 490387584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ce8e1ecfb9d87f4aa578fc6ee02388b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ETVRTool.CraneLevel.PipeLevelManager
  crane: {fileID: 403581672}
  hook: {fileID: 420500758}
  steps:
  - title: Pipe P1 to Tower A
    instruction: 'Drive the crane over pipe P1 in the storage rack (left, on the blue stands).

      Lower the hook onto the yellow master link and press ATTACH.

      Lift it clear, turn it 90 degrees and bring it to the blue ghost pipe at Tower A.

      Use CREEP for the last centimetres. RELEASE when the ghost turns green.'
    pipe: {fileID: 1919351616}
    target: {fileID: 1483630805}
  - title: Pipe P2 to Tower B
    instruction: 'Connect pipe P2 between pipe P1 and Tower B.

      The flanges must meet exactly - watch the Side / Height / Angle readout.'
    pipe: {fileID: 946614758}
    target: {fileID: 1631515297}
  - title: 'Long pipe P3: Tower A to Tower C'
    instruction: 'Pipe P3 is 5 m long. Lift it high enough to clear the towers and

      line it up between Tower A and Tower C. Long loads need extra care!'
    pipe: {fileID: 1774536227}
    target: {fileID: 201569904}
  titleText: {fileID: 536534284}
  bodyText: {fileID: 2061855614}
  statusText: {fileID: 123463113}
  messageText: {fileID: 486056134}
  messageSeconds: 4
